JWT_SECRET=__GENERATED_JWT_SECRET__
JWT_EXPIRES_IN=8h
NODE_ENV=development
PORT=3101
CLIENT_URL=http://127.0.0.1:3101
SOCKET_CORS_ORIGIN=http://127.0.0.1:3101,http://localhost:3101

DB_ADAPTER=json
USE_JSON_DB=true
JSON_DB_PATH=%LOCALAPPDATA%/Onion/runtime/db.json
JSON_EPHEMERAL_COLLECTIONS=activeChats,chats,chatMessages,chatEvents,contacts,mediaAssets,systemLogs,aiMemories,telegramSessions,outreachCampaigns,outreachCampaignItems
DB_AUTO_INDEX=false
COMPANION_MODE=true

CHAT_STATE_REPAIR_ON_BOOT=false
CHAT_RUNTIME_WATCHER_ENABLED=false
DB_CHANGE_LOGGER_ENABLED=false
OUTREACH_CAMPAIGN_WORKER_ENABLED=false
TELEGRAM_USE_POLLING=false
SUPER_ADMIN_ALLOWED_IPS=
SUPER_ADMIN_IP_WHITELIST_DISABLED=true
WHATSAPP_FAKE_SEND=true
WHATSAPP_FAKE_MEDIA_DIR=./sandbox/fake-whatsapp-media

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_MAX=50
HEARTBEAT_LAST_SEEN_MIN_MS=60000

SANDBOX_ADMIN_USERNAME=admin
SANDBOX_ADMIN_PASSWORD=sandbox123
SANDBOX_AGENT_USERNAME=agent
SANDBOX_AGENT_PASSWORD=sandbox123

# IA desativada por padrao. Configure chaves somente no .env.sandbox local.
GEMINI_GENESYS_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_GENESYS_HISTORY_MESSAGES=2000
GEMINI_SYSTEM_PROMPT=Voce e um copiloto do agente. Analise toda a conversa, considere o que cliente e agente ja disseram, evite repeticoes, nao invente dados ou prazos e sugira a melhor proxima resposta em portugues do Brasil para revisao humana.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
