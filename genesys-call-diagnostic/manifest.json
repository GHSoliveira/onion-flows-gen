{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Onion Sync Diagnostic",
  "version": "0.2.0",
  "description": "Captura local e sanitizada da sincronização de chats e ligações no Genesys.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://apps.sae1.pure.cloud/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Diagnóstico de sincronização",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://apps.sae1.pure.cloud/*"],
      "js": ["page-probe.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://apps.sae1.pure.cloud/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
